:80 {
    handle /api-r/* {
        reverse_proxy api-rust:3100
    }

    handle /api/* {
        reverse_proxy api:3000
    }

    root * /srv/site

    redir /lmi-r /lmi-r/

    handle_path /lmi-r/* {
        root * /srv/site/lmi-r/dist
        try_files {path} /index.html
        file_server
    }

    @lmiCode path /lmi/*.html /lmi/desktop/*.html /lmi/modules/*.html /lmi/scripts/*.js /lmi/module-manifest.json
    header @lmiCode Cache-Control "no-store, max-age=0"

    @vehicleModelManifests path /lmi/assets/vehicles/models/*/manifest.json
    header @vehicleModelManifests Cache-Control "no-store, max-age=0"

    @vehicleModelBinaries path /lmi/assets/vehicles/models/*/model.glb
    header @vehicleModelBinaries Cache-Control "public, max-age=31536000, immutable"

    file_server
}
